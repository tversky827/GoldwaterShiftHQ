# =====================================================================
#  GoldwaterShiftHQ settings template
# ---------------------------------------------------------------------
#  This file is a TEMPLATE. It contains NO real secrets and is safe to
#  commit to GitHub.
#
#  To use it on your computer: copy it to a file named  .env.local
#  (that file is ignored by git, so it never goes to GitHub) and fill in
#  the values there. When the app is hosted (e.g. Vercel), enter the same
#  names and values in the host's "Environment Variables" screen instead.
#
#  NEVER paste real secrets into chat, email, tickets, or source code.
#  See docs/integrations/05-secure-credentials.md
# =====================================================================

# ---------- Application ----------
# development | production. "production" refuses to load demonstration data.
APP_ENV=development

# Database. Leave EMPTY on your computer to use the built-in local database
# (stored in ./data/pglite). In hosting, set the managed PostgreSQL URL
# (e.g. from Supabase: Project Settings -> Database -> Connection string).
DATABASE_URL=

# A long random string used to encrypt saved Paycor tokens on disk.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Public address of this app. Used to build the Paycor redirect URL and invite links.
# Local computer: http://localhost:3000   Hosted: https://your-app-domain
APP_BASE_URL=http://localhost:3000

# Secret that protects the scheduled sync endpoint (/api/cron/sync). Generate like the key above.
CRON_SECRET=

# How long a sign-in lasts without activity (hours).
SESSION_TTL_HOURS=12

# =====================================================================
#  PAYCOR (HR / employee records)
# =====================================================================
# demo       = built-in fictional employees (no Paycor account needed)
# sandbox    = Paycor's test environment (fake data, safe to experiment)
# production = your REAL Paycor data
PAYCOR_MODE=demo

# From Paycor AppCreator (developer portal). The Client ID is not secret;
# the Client Secret and Subscription Key ARE secret.
PAYCOR_CLIENT_ID=
PAYCOR_CLIENT_SECRET=
PAYCOR_SUBSCRIPTION_KEY=

# The "scope name" shown on your app's General tab in AppCreator.
PAYCOR_APP_SCOPE=

# The exact "Activation URL" / authorization link shown in AppCreator.
# (Copy it from the portal - we do not guess this value.)
PAYCOR_ACTIVATION_URL=

# Import pay rates (owner-approved). Leave "false" until the pay-rate endpoint
# and the scope it needs are confirmed in the Paycor portal. Demo mode always
# imports fictional rates. Pay is visible only to roles with "pay.view".
PAYCOR_IMPORT_PAY_RATES=false

# Optional overrides. Leave blank unless Paycor's portal shows different values.
# Defaults (verified in Paycor's guides): production https://apis.paycor.com, sandbox https://apis-sandbox.paycor.com;
# token URL is <base>/sts/v1/common/token.
PAYCOR_API_BASE_URL=
PAYCOR_TOKEN_URL=

# =====================================================================
#  ATTENDANCE ON DEMAND (timekeeping / punches)
# =====================================================================
# demo = built-in fictional punches
# soap = AOD Web Services (CC1/SOAP) - requires an AOD "Access Account"
# file = read AOD scheduled export files (CSV) from AOD_EXPORT_DIR
AOD_MODE=demo

# test       = AOD test/development database (use for all early testing)
# production = your REAL AOD database
AOD_ENVIRONMENT=test

# Your company's AOD web address host. Goldwater's is goldwater.attendanceondemand.com
# (no https://, no slashes). AOD identifies your account by this address.
AOD_HOSTNAME=
AOD_PORT=8192

# The AOD "Access Account" used by web services (NOT your personal login).
AOD_ACCESS_ACCOUNT=
AOD_ACCESS_PASSWORD=

# Folder containing AOD export files when AOD_MODE=file
AOD_EXPORT_DIR=./data/aod-exports

# Which field links an AOD employee to a Paycor employee.
# Usually the employee number. Confirm during setup (see guide 04).
EMPLOYEE_MATCH_FIELD=employeeNumber

# ---------------------------------------------------------------- Notifications
# In-app notifications always work. Email and text messages are optional; use
# either, both or neither. Leave blank to keep them off. Never paste these
# values into chat; put them in .env.local or your hosting service's settings.
#
# Email option A: your own mailbox over SMTP (e.g. Microsoft 365)
#   NOTIFY_EMAIL_PROVIDER=smtp, SMTP_HOST=smtp.office365.com, SMTP_PORT=587,
#   SMTP_USER=<mailbox>, SMTP_PASSWORD=<password or app password>
# Email option B: SendGrid
#   NOTIFY_EMAIL_PROVIDER=sendgrid, SENDGRID_API_KEY=<key>
NOTIFY_EMAIL_PROVIDER=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_FROM_NAME=ShiftHQ
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
#
# Text messages: Twilio. NOTIFY_SMS_PROVIDER=twilio, plus the account SID,
# auth token, and either a sending number (+15555550123) or a Messaging Service SID.
# Only people who add their number and agree in Profile -> Notifications get texts.
NOTIFY_SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
#
# Development only: NOTIFY_EMAIL_PROVIDER=log / NOTIFY_SMS_PROVIDER=log writes to the server log.
# Background jobs also run automatically while people use the app; set to true to rely only on cron.
DISABLE_BACKGROUND_JOBS=
